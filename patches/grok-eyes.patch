@@ -171,6 +240,27 @@ public:
         return display_;
     }
 
+    virtual bool GetBatteryLevel(int& level, bool& charging, bool& discharging) override {
+        if (!ip5306_ready_) {
+            // 这块板的 IP5306 没有把 I2C 接到 MCU，读不到真实电量，
+            // 直接不显示电量图标，避免给用户一个假的满电数值
+            return false;
+        }
+        uint8_t reg78 = 0, reg70 = 0;
+        if (!Ip5306ReadReg(0x78, &reg78)) {
+            return false;
+        }
+        Ip5306ReadReg(0x70, &reg70);
+        static const int kLevels[] = {0, 25, 50, 75};
+        int leds = (reg78 >> 5) & 0x03;                 // 0x78 高两位 = 电量格数
+        bool charge_on = (reg70 & 0x08) != 0;           // bit3 充电中
+        bool charge_full = (reg70 & 0x04) != 0;         // bit2 充满
+        level = charge_full ? 100 : kLevels[leds];
+        charging = charge_on || charge_full;
+        discharging = !charging;
+        return true;
+    }
