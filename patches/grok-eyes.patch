+void LcdDisplay::ApplyEyesOnlyStyle() {
+    /* 极简模式：纯黑底 + 白眼表情，顶部保留白色 WiFi 与电量图标。
+       注意：SetTheme() 会在开机后重新刷一遍主题样式，必须在这里重新覆盖。 */
+    lv_obj_t* screen = lv_screen_active();
+    if (screen != nullptr) {
+        lv_obj_set_style_bg_color(screen, lv_color_black(), 0);
+        lv_obj_set_style_bg_opa(screen, LV_OPA_COVER, 0);
+        lv_obj_set_style_text_color(screen, lv_color_white(), 0);
+    }
+    if (container_ != nullptr) {
+        lv_obj_set_style_bg_color(container_, lv_color_black(), 0);
+        lv_obj_set_style_bg_opa(container_, LV_OPA_COVER, 0);
+        lv_obj_set_style_bg_image_src(container_, nullptr, 0);
+    }
+    if (status_bar_ != nullptr) {
+        lv_obj_add_flag(status_bar_, LV_OBJ_FLAG_HIDDEN);
+    }
+    if (bottom_bar_ != nullptr) {
+        lv_obj_add_flag(bottom_bar_, LV_OBJ_FLAG_HIDDEN);
+    }
+    if (emoji_label_ != nullptr) {
+        lv_obj_add_flag(emoji_label_, LV_OBJ_FLAG_HIDDEN);
+    }
+    if (low_battery_popup_ != nullptr) {
+        lv_obj_add_flag(low_battery_popup_, LV_OBJ_FLAG_HIDDEN);
+    }
+    if (top_bar_ != nullptr) {
+        lv_obj_set_style_bg_opa(top_bar_, LV_OPA_TRANSP, 0);
+        lv_obj_set_style_border_width(top_bar_, 0, 0);
+        lv_obj_add_flag(top_bar_, LV_OBJ_FLAG_HIDDEN);
+    }
+    /* 顶部图标直接从 top_bar_ 挪到 screen 上，避免 top_bar 的白底/布局把图标挤掉或盖住 */
+    if (screen != nullptr) {
+        if (network_label_ != nullptr) {
+            lv_obj_set_parent(network_label_, screen);
+            lv_obj_align(network_label_, LV_ALIGN_TOP_LEFT, 12, 6);
+            lv_obj_move_foreground(network_label_);
+            lv_obj_set_style_text_color(network_label_, lv_color_white(), 0);
+        }
+        if (battery_label_ != nullptr) {
+            lv_obj_set_parent(battery_label_, screen);
+            lv_obj_align(battery_label_, LV_ALIGN_TOP_RIGHT, -12, 6);
+            lv_obj_move_foreground(battery_label_);
+            lv_obj_set_style_text_color(battery_label_, lv_color_white(), 0);
+        }
+    }
+    if (mute_label_ != nullptr) {
+        lv_obj_add_flag(mute_label_, LV_OBJ_FLAG_HIDDEN);
+    }
 }
 
