+void LcdDisplay::SetEyesOnly(bool enable) {
+    DisplayLockGuard lock(this);
+    eyes_only_ = enable;
+    if (!setup_ui_called_) {
+        // SetupUI 时会按 eyes_only_ 应用一次
+        return;
+    }
+    if (enable) {
+        ApplyEyesOnlyStyle();
+    }
+}
+
+void LcdDisplay::SetEmotionAnimating(bool animating) {
+    DisplayLockGuard lock(this);
+    if (emoji_animating_ == animating) {
+        return;
+    }
+    emoji_animating_ = animating;
+    if (gif_controller_) {
+        if (animating) {
+            gif_controller_->Resume();
+        } else {
+            gif_controller_->Pause();
+        }
+    }
+}
