diff --git a/main/boards/bread-compact-wifi-lcd/compact_wifi_board_lcd.cc b/main/boards/bread-compact-wifi-lcd/compact_wifi_board_lcd.cc
index 431cc43..633873d 100644
--- a/main/boards/bread-compact-wifi-lcd/compact_wifi_board_lcd.cc
+++ b/main/boards/bread-compact-wifi-lcd/compact_wifi_board_lcd.cc
@@ -59,11 +59,72 @@ static const gc9a01_lcd_init_cmd_t gc9107_lcd_init_cmds[] = {
  
 #define TAG "CompactWifiBoardLCD"
 
+/* ---------------- IP5306 电源管理芯片（I2C 0x75） ---------------- */
+/* 这块板子的 IP5306 到底接在哪两个脚没有官方文档，这里开机自动扫描空闲引脚，
+   命中 0x75 就一直用它；扫不到则视为没有电池，状态栏不显示电量。 */
+#define IP5306_ADDR 0x75
+static i2c_master_bus_handle_t s_ip_bus = nullptr;
+static i2c_master_dev_handle_t s_ip_dev = nullptr;
+
+static bool Ip5306ReadReg(uint8_t reg, uint8_t* value) {
+    if (s_ip_dev == nullptr) {
+        return false;
+    }
+    uint8_t buf = reg;
+    return i2c_master_transmit_receive(s_ip_dev, &buf, 1, value, 1, 50) == ESP_OK;
+}
+
+static bool ProbeIp5306() {
+    // 排除音频(4,5,6,7,15,16)、屏幕(21,40,41,42,45,47)、LED(48)、BOOT(0)、灯(18)、USB(19,20)、UART(43,44)、八线PSRAM(33-37)
+    static const gpio_num_t kCandidates[] = {
+        GPIO_NUM_1, GPIO_NUM_2, GPIO_NUM_3, GPIO_NUM_8, GPIO_NUM_9, GPIO_NUM_10,
+        GPIO_NUM_11, GPIO_NUM_12, GPIO_NUM_13, GPIO_NUM_14, GPIO_NUM_17,
+        GPIO_NUM_38, GPIO_NUM_39,
+    };
+    const int n = sizeof(kCandidates) / sizeof(kCandidates[0]);
+    for (int i = 0; i < n; i++) {
+        for (int j = 0; j < n; j++) {
+            if (i == j) {
+                continue;
+            }
+            i2c_master_bus_config_t bus_cfg = {};
+            bus_cfg.i2c_port = I2C_NUM_0;
+            bus_cfg.sda_io_num = kCandidates[i];
+            bus_cfg.scl_io_num = kCandidates[j];
+            bus_cfg.clk_source = I2C_CLK_SRC_DEFAULT;
+            bus_cfg.glitch_ignore_cnt = 7;
+            bus_cfg.intr_priority = 0;
+            bus_cfg.flags.enable_internal_pullup = true;
+            i2c_master_bus_handle_t bus = nullptr;
+            if (i2c_new_master_bus(&bus_cfg, &bus) != ESP_OK) {
+                continue;
+            }
+            if (i2c_master_probe(bus, IP5306_ADDR, 10) == ESP_OK) {
+                i2c_device_config_t dev_cfg = {};
+                dev_cfg.dev_addr_length = I2C_ADDR_BIT_LEN_7;
+                dev_cfg.device_address = IP5306_ADDR;
+                dev_cfg.scl_speed_hz = 100000;
+                if (i2c_master_bus_add_device(bus, &dev_cfg, &s_ip_dev) == ESP_OK) {
+                    s_ip_bus = bus;
+                    ESP_LOGW(TAG, "IP5306 found: SDA=GPIO%d SCL=GPIO%d", (int)kCandidates[i], (int)kCandidates[j]);
+                    return true;
+                }
+                ESP_LOGW(TAG, "IP5306 found on SDA=GPIO%d SCL=GPIO%d but add_device failed", (int)kCandidates[i], (int)kCandidates[j]);
+            }
+            i2c_del_master_bus(bus);
+        }
+    }
+    ESP_LOGW(TAG, "IP5306 not found on any free pin pair, battery icon disabled");
+    return false;
+}
+
